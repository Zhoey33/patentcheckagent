# 这个文件用于给 asqmsl.cn 生产部署提供环境变量填写模板，不包含真实密钥。

APP_ENV=production
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
FRONTEND_URL=https://check.asqmsl.cn
NEXT_PUBLIC_API_BASE_URL=https://check.asqmsl.cn
LOG_LEVEL=INFO

POSTGRES_DB=patent_check_agent
POSTGRES_USER=patent_user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

REDIS_URL=redis://redis:6379/0

PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
CODEX_NPM_REGISTRY=https://registry.npmmirror.com

WORKER_JOB_TIMEOUT_SECONDS=1800

GPT_BASE_URL=https://helloapi.cc
GPT_API_KEY=replace-with-company-api-key
GPT_MODEL=gpt-5.5

CODEX_COMMAND=codex
CODEX_SKILL_PATH=skills/check-patent.md
CODEX_TIMEOUT_SECONDS=300
CODEX_MODEL=
CODEX_SANDBOX_MODE=read-only

MAX_FILE_SIZE_MB=20
MAX_TASK_FILES=4
MAX_TOTAL_TEXT_CHARS=200000
UPLOAD_DIR=/app/uploads

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_USER1_USERNAME=researcher1
SEED_USER1_PASSWORD=replace-with-a-strong-user-password
SEED_USER2_USERNAME=researcher2
SEED_USER2_PASSWORD=replace-with-a-strong-user-password
