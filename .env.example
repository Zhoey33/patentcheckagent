# 这个文件用于展示本地开发和部署所需环境变量，不包含真实密钥。

APP_ENV=development
APP_SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

POSTGRES_DB=patent_check_agent
POSTGRES_USER=patent_user
POSTGRES_PASSWORD=patent_password
DATABASE_URL=postgresql+psycopg://patent_user:patent_password@postgres:5432/patent_check_agent

REDIS_URL=redis://redis:6379/0

# Docker base images. If Docker Hub times out in mainland China, replace these
# values with an available registry mirror such as docker.m.daocloud.io/library/node:22-alpine.
PYTHON_BASE_IMAGE=python:3.12-slim
NODE_BASE_IMAGE=node:22-alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
NGINX_IMAGE=nginx:1.27-alpine

WORKER_JOB_TIMEOUT_SECONDS=1800

# Model runtime. GPT_* config is passed into Codex CLI as an OpenAI-compatible provider.
GPT_BASE_URL=https://your-openai-compatible-endpoint.example
GPT_API_KEY=
GPT_MODEL=gpt-5.5

# Codex runtime. CODEX_COMMAND must be available inside backend and worker containers.
CODEX_COMMAND=codex
CODEX_SKILL_PATH=skills/check-patent/SKILL.md
CODEX_TIMEOUT_SECONDS=600
CODEX_MODEL=
CODEX_REASONING_EFFORT=low
CODEX_SANDBOX_MODE=workspace-write

MAX_FILE_SIZE_MB=20
MAX_TASK_FILES=4
UPLOAD_DIR=/app/uploads

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_USER1_USERNAME=researcher1
SEED_USER1_PASSWORD=ChangeMeUser123!
SEED_USER2_USERNAME=researcher2
SEED_USER2_PASSWORD=ChangeMeUser123!
